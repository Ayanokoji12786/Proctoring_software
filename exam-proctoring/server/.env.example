# Copy this file to .env and fill in real values before running the server.
# Never commit a real .env file.

# --- Database ---
# SQLite for the prototype. To migrate to PostgreSQL later, change this to
# something like postgresql+psycopg://user:pass@host:5432/proctoring
DATABASE_URL=sqlite:///./proctoring.db

# --- Auth ---
# JWT secret used to sign short-lived student session tokens. Generate a real
# random value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_DEV_SECRET_DO_NOT_USE_IN_PRODUCTION
STUDENT_TOKEN_TTL_MINUTES=240

# API key the Admin Dashboard must send (X-Admin-Api-Key header, or
# ?api_key= on the /ws/admin WebSocket) to access proctor-only endpoints.
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# --- Connection management ---
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=20

# --- Evidence snapshots ---
EVIDENCE_STORAGE_DIR=./evidence_storage
EVIDENCE_RETENTION_HOURS=72
EVIDENCE_MAX_BYTES=2097152

# --- CORS ---
# Comma-separated origins allowed to call the REST API / open the admin
# WebSocket from a browser. "*" is fine for local development only.
CORS_ALLOW_ORIGINS=*
