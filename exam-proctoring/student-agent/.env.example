# Copy this file to .env and fill in real values before running the agent.
# session_id / student_id / token are normally issued by the proctor via the
# server's enrollment endpoint (see register_student.py) rather than typed by
# the student, but can be supplied here or via --session-id/--student-id/--token
# command-line flags (flags take precedence over this file).

SERVER_WS_URL=ws://localhost:8000
SERVER_HTTP_URL=http://localhost:8000
EXAM_SESSION_ID=
STUDENT_ID=
STUDENT_NAME=
STUDENT_TOKEN=

# --- Networking ---
HEARTBEAT_INTERVAL_SECONDS=5
RECONNECT_INITIAL_BACKOFF=1
RECONNECT_MAX_BACKOFF=30
CONNECTION_TIMEOUT_SECONDS=10

# --- Local durability ---
LOCAL_QUEUE_PATH=agent_event_queue.jsonl
AGENT_LOG_PATH=agent.log

# --- Monitors ---
WINDOW_MONITOR_ENABLED=true
WINDOW_POLL_INTERVAL_SECONDS=1
DISPLAY_MONITOR_ENABLED=true
DISPLAY_POLL_INTERVAL_SECONDS=3
CAMERA_MONITOR_ENABLED=true
CAMERA_INDEX=0
CAMERA_FRAME_INTERVAL_SECONDS=0.5

# --- Bypass / mirroring detection ---
# Flags known remote-access and virtual-camera tools running on this
# machine (detection only, nothing is blocked). See README "Bypass &
# mirroring detection" for what this can and can't actually catch.
PROCESS_MONITOR_ENABLED=true
PROCESS_SCAN_INTERVAL_SECONDS=5
# Comma-separated, case-insensitive substring match against process names.
# REMOTE_ACCESS_PROCESS_KEYWORDS=teamviewer,anydesk,splashtop,logmein,gotomypc,vncserver,tigervnc,realvnc,x11vnc,vino-server
# VIRTUAL_CAMERA_PROCESS_KEYWORDS=obs64,obs32,obs,snapcamera,manycam,camtwist,xsplit,iriunwebcam,iriun,droidcam,epoccam
# Treat a second/mirrored display as critical (red) immediately instead of
# yellow-by-default for a plain extended display:
TREAT_MULTI_DISPLAY_AS_CRITICAL=false

# --- Face / gaze thresholds (seconds) ---
NO_FACE_THRESHOLD_SECONDS=5
MULTIPLE_FACE_THRESHOLD_SECONDS=2
FACE_AWAY_THRESHOLD_SECONDS=5
PROLONGED_ABSENCE_THRESHOLD_SECONDS=30
LOOK_AWAY_THRESHOLD_SECONDS=7

# --- Evidence snapshots ---
EVIDENCE_CAPTURE_ENABLED=true
EVIDENCE_MAX_DIMENSION=640
EVIDENCE_JPEG_QUALITY=60
